## Admin
ADMIN_PASSWORD=

## Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

## Yalidine API (Official)
# Base should include /v1
YALIDINE_API_BASE_URL=https://api.yalidine.app/v1

# Official auth headers
YALIDINE_API_ID=
YALIDINE_API_TOKEN=

# Sender (your shop) wilaya id
YALIDINE_FROM_WILAYA_ID=

# Optional: override sender wilaya name (otherwise resolved by ID)
YALIDINE_FROM_WILAYA_NAME=

# Optional: custom auth (legacy fallback)
YALIDINE_API_HEADER_NAME=Authorization
YALIDINE_API_HEADER_VALUE=

# Endpoint paths (defaults match official API)
YALIDINE_WILAYAS_PATH=/wilayas/
YALIDINE_COMMUNES_PATH=/communes/
YALIDINE_FEES_PATH=/fees/
YALIDINE_CENTERS_PATH=/centers/
YALIDINE_CREATE_PARCEL_PATH=/parcels/

# Optional parcel defaults (used for overweight fee & parcel creation)
YALIDINE_DEFAULT_WEIGHT_KG=1
YALIDINE_DEFAULT_LENGTH_CM=30
YALIDINE_DEFAULT_WIDTH_CM=20
YALIDINE_DEFAULT_HEIGHT_CM=10
